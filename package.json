{
  "name": "maxball",
  "version": "0.1.0",
  "private": true,
  "description": "MAXBALL - futebol arcade, carreira e multiplayer",
  "scripts": {
    "start": "node server/index.cjs",
    "check": "node scripts/check.cjs",
    "check:supabase": "node scripts/check-supabase.cjs",
    "test": "node --liftoff-only --no-wasm-tier-up --wasm-num-compilation-tasks=1 --wasm-lazy-compilation --test --test-concurrency=1 --test-timeout=30000 tests/*.test.cjs",
    "start:offline": "node scripts/serve.cjs",
    "migrate": "node scripts/migrate.cjs",
    "admin": "node scripts/admin.cjs"
  },
  "engines": {
    "node": ">=24.14"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "jsdom": "^30.1.1"
  }
}
