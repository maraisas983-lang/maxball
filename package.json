{
  "name": "maxball",
  "version": "0.1.0",
  "private": true,
  "description": "MAXBALL - futebol arcade, carreira e multiplayer",
  "scripts": {
    "start": "node server/index.cjs",
    "dev": "node --watch server/index.cjs",
    "check": "node scripts/check.cjs",
    "check:supabase": "node scripts/check-supabase.cjs",
    "check:cakto": "node scripts/check-cakto.cjs",
    "test": "node --max-old-space-size=128 --no-opt --liftoff-only --no-wasm-tier-up --wasm-num-compilation-tasks=1 --wasm-lazy-compilation --test --test-concurrency=1 --test-timeout=90000 tests/*.test.cjs",
    "start:offline": "node scripts/serve.cjs",
    "migrate": "node scripts/migrate.cjs",
    "admin": "node scripts/admin.cjs",
    "android:assets": "node scripts/android-assets.cjs",
    "android:apk": "node scripts/android-build.cjs",
    "android:apk:lite": "node --max-old-space-size=128 --max-semi-space-size=1 scripts/android-build-lite.cjs"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@electric-sql/pglite": "^0.5.8",
    "jsdom": "^30.1.1"
  }
}
