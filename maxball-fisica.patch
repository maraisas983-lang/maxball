+const test=require('node:test'),assert=require('node:assert/strict');
+const {scene,physics}=require('./gameplay-calibration.cjs');
+const cfg=require('../src/core/config.js').physics;
+const {moveBall}=require('../src/physics/ballPhysics.js');
+const {Match}=require('../server/online/match.cjs');
+
+test('upward joystick cannot redirect a ball touching the right side (shot and pass)',()=>{
+ for(const action of ['shoot','pass']){
+  const s=scene(),p=s.P[0];p.fx=0;p.fy=-1;
+  const sim=physics(s,{x:0,y:-1,[action]:true});sim.step(1/60);
+  const dx=s.ball.x-p.x,dy=s.ball.y-p.y;
+  assert.equal(s.ball.kickedBy,p.id);assert.ok(s.ball.vx>200);
+  assert.ok(Math.abs(s.ball.vx*dy-s.ball.vy*dx)<1e-8);
+  assert.ok(Math.abs(s.ball.vy)<s.ball.vx*.1);
+ }
+});
+test('all 72 contact angles ignore opposite facing and an explicit unrelated aim',()=>{
+ for(const type of ['s','p'])for(let angle=0;angle<360;angle+=5){
+  const s=scene(),p=s.P[0],x=Math.cos(angle*Math.PI/180),y=Math.sin(angle*Math.PI/180),r=cfg.playerRadius+s.BR;
+  p.fx=-x;p.fy=-y;p.aimStrength=.02;s.ball.x=p.x+r*x;s.ball.y=p.y+r*y;
+  assert.ok(physics(s,{}).kick(p,type,{x:-y*500,y:x*500}));
+  const speed=type==='s'?cfg.shotImpulse:cfg.passImpulse;
+  assert.ok(Math.abs(s.ball.vx-x*speed)<1e-8);assert.ok(Math.abs(s.ball.vy-y*speed)<1e-8);
+ }
+});
+test('glancing kicks preserve tangential momentum; normal power does not stack',()=>{
+ for(const type of ['s','p']){
+  const s=scene(),p=s.P[0];s.ball.vx=-90;s.ball.vy=70;const sim=physics(s,{});
+  assert.ok(sim.kick(p,type));assert.equal(s.ball.vy,70);
+  const outgoing=s.ball.vx;p.cd=0;s.G.kl=0;
+  assert.ok(sim.kick(p,type));assert.equal(s.ball.vx,outgoing);assert.equal(s.ball.vy,70);
+ }
+});
+test('changing joystick with no contact cannot steer a free ball',()=>{
+ const s=scene();s.ball.x+=200;s.ball.vx=200;s.ball.vy=0;
+ const sim=physics(s,{x:0,y:-1,shoot:true,pass:true});
+ for(let i=0;i<30;i++){sim.step(1/60);moveBall(s,1/60);assert.equal(s.ball.vy,0);}
+ assert.equal(s.ball.kickedBy,undefined);
+});
+test('server authoritative input uses the same contact direction as local play',()=>{
+ for(const action of ['shoot','pass']){
+  const m=new Match({id:action,players:[{id:'human',team:0,slot:0}],cfg:{n:1}}),p=m.P[0];m.P=[p];m.G.restarting=false;m.G.kl=0;
+  p.x=300;p.y=250;p.vx=p.vy=0;p.cd=0;m.ball.x=p.x+cfg.playerRadius+m.BR;m.ball.y=p.y;m.ball.vx=m.ball.vy=0;
+  m.setInput(p.id,{x:0,y:-1,[action]:true});m.update(1/60);
+  assert.equal(m.ball.kickedBy,p.id);assert.ok(m.ball.vx>200);assert.ok(Math.abs(m.ball.vy)<m.ball.vx*.1);
+ }
+});
