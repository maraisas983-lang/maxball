HOST=127.0.0.1
PORT=5173
PUBLIC_ORIGIN=http://127.0.0.1:5173
DATABASE_PATH=var/maxball.sqlite
NODE_ENV=development
# Production requires HTTPS. Render can derive the origin from RENDER_EXTERNAL_HOSTNAME;
# on other hosts, set PUBLIC_ORIGIN=https://your-host.
# local funciona sem serviço externo; supabase usa autenticação por e-mail.
AUTH_PROVIDER=local
# E-mails confirmados no Supabase que recebem ADMIN ao entrar; separados por vírgula.
ADMIN_EMAILS=
# Limites por processo; execute uma única instância com SQLite persistente.
MAX_ROOMS=100
MAX_CONNECTIONS=1000
WS_ACCOUNT_HANDSHAKES=30
WS_IP_HANDSHAKES=1200
WS_MESSAGES_PER_SECOND=90
API_ACCOUNT_PER_MINUTE=300
ROOM_OPERATIONS_PER_MINUTE=30
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Exclusiva do servidor. Nunca colocar em src/, HTML ou no repositório.
SUPABASE_SECRET_KEY=
# Credenciais da API Cakto: exclusivas do backend, diferentes da chave do webhook.
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=
# Nomes antigos SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY continuam aceitos.
